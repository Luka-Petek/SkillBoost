# Render Web Service -> Environment
# Do not commit real secrets. Add real values directly in Render.

PORT=10000
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod
SKILLBOOST_SECURITY_ENABLED=false

# Use MongoDB Atlas or another external MongoDB instance for production.
SPRING_DATA_MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/skillboost?retryWrites=true&w=majority

# AI judging
GEMINI_API_KEY=PASTE_YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_ENABLED=false
GEMINI_MAX_OUTPUT_TOKENS=900
GEMINI_TEMPERATURE=0.25
GEMINI_THINKING_BUDGET=0
GEMINI_THINKING_LEVEL=minimal

# Optional JVM memory tuning for Render Starter
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0 -XX:+UseContainerSupport

# Enable only after Keycloak is publicly hosted and frontend is rebuilt with VITE_AUTH_ENABLED=true.
KEYCLOAK_ISSUER_URI=https://YOUR_KEYCLOAK_DOMAIN/realms/SkillBoost
KEYCLOAK_JWK_SET_URI=https://YOUR_KEYCLOAK_DOMAIN/realms/SkillBoost/protocol/openid-connect/certs
